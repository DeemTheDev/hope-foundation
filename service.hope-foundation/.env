# ---------------------------------------------------------------------------
# service.hope-foundation environment variables
#
# This file is TRACKED in git and contains PLACEHOLDERS ONLY. Never put a real
# value in here. Copy it to .env.local (ignored by git) and fill that in.
# Next.js loads .env first, then .env.local overrides it.
#
# Status legend
#   [have]      a value already exists in client.hope-foundation/.env and can be reused
#   [gather]    Nadeem collects it from the platform named in the comment
#   [generate]  create it locally:  openssl rand -base64 32
#   [later]     not needed until the related task is done
# ---------------------------------------------------------------------------

# --- Database: Neon project "HopeFoundation" ------------------------------
# [have] same database as the mobile app (client .env DATABASE_URL). The leaked
# password is being reset; use the NEW connection string. Local development uses
# the dev-mian branch string; production uses the main branch string.
DATABASE_URL=

# --- Admin login: Auth.js v5 with the GitHub provider ----------------------
# [generate] openssl rand -base64 32
AUTH_SECRET=
# [gather] GitHub -> Settings -> Developer settings -> OAuth Apps.
# Callback URL: http://localhost:3000/api/auth/callback/github (dev) or https://<site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only on hosts other than Vercel (for example Azure):
# AUTH_TRUST_HOST=true
# Comma-separated, lower-case emails allowed into /admin (replaces the hard-coded address)
ADMIN_EMAILS=

# --- Organisation sessions (replaces the forgeable org_id cookie; AI_CONTEXT P5)
# [generate] openssl rand -base64 32
SESSION_SECRET=

# --- Image storage ----------------------------------------------------------
# [gather] current S3 bucket: AWS console -> S3 (name, region) and IAM -> access keys.
# To be replaced by Azure Blob Storage (ADR-003); keep until the adapter exists.
NEXT_AWS_S3_REGION=
NEXT_AWS_S3_BUCKET_NAME=
NEXT_AWS_S3_ACCESS_KEY_ID=
NEXT_AWS_S3_SECRET_ACCESS_KEY=
# [later] Azure Blob Storage, once the storage account exists in rg-hope-foundation
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=images

# --- Mobile API, once the Expo API routes move into this app (AI_CONTEXT P7-P9)
# [have] client .env STRIPE_SECRET_KEY (test mode); roll it in Stripe first
STRIPE_SECRET_KEY=
# [have] client .env EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY (needed here only for donate-on-web)
STRIPE_PUBLISHABLE_KEY=
# [gather] Clerk Dashboard -> API keys -> Secret key (same instance as the mobile publishable key)
CLERK_SECRET_KEY=
# [later] only if the Stripe webhook variant of payment verification is used
# STRIPE_WEBHOOK_SECRET=
