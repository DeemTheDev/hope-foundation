{
  "expo": {
    "name": "hope",
    "slug": "hope",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": ""
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://hopefoundation.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#00D09E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
